{
	"name": "@code-yeongyu/codex-telemetry",
	"version": "5.1.65",
	"description": "Codex plugin component that emits omc-codex anonymous daily-active telemetry on SessionStart.",
	"type": "module",
	"packageManager": "npm@11.12.1",
	"license": "MIT",
	"homepage": "https://github.com/code-yeongyu/oh-my-cybersecurity",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/code-yeongyu/oh-my-cybersecurity.git"
	},
	"bugs": {
		"url": "https://github.com/code-yeongyu/oh-my-cybersecurity/issues"
	},
	"keywords": [
		"codex",
		"codex-plugin",
		"omc",
		"telemetry",
		"posthog",
		"hooks",
		"daily-active"
	],
	"bin": {
		"omc-telemetry": "./dist/cli.js"
	},
	"files": [
		"dist",
		"hooks",
		"LICENSE",
		"NOTICE",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && bun build src/cli.ts --target node --format esm --outfile dist/cli.js && bun build src/posthog.ts --target node --format esm --outfile dist/posthog.js",
		"test": "vitest --run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome format .",
		"lint:fix": "biome format --write .",
		"check": "tsc --noEmit && biome format . && npm run build"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "5.0.1",
		"@oh-my-cybersecurity/telemetry-core": "file:../../../../telemetry-core",
		"@biomejs/biome": "2.5.14",
		"@types/node": "^26.6.2",
		"typescript": "^7.0.2",
		"vitest": "5.0.1"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
