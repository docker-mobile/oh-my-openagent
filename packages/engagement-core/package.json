    },
    "./contracts": {
      "types": "./contracts.d.ts",
      "import": "./src/contracts.ts"
    },
    "./prompt-assembly": {
      "types": "./prompt-assembly.d.ts",
      "import": "./src/prompt-assembly.ts"
    },
    "./plan-delta": {
      "types": "./plan-delta.d.ts",
      "import": "./src/plan-delta.ts"
    },
    "./model-catalog": {
      "types": "./model-catalog.d.ts",
      "import": "./src/model-catalog.ts"
    },
    "./toolcall-guard": {
      "types": "./toolcall-guard.d.ts",
      "import": "./src/toolcall-guard.ts"
    }
  },
  "types": "./index.d.ts",
  "scripts": {
    "typecheck": "tsgo --noEmit -p tsconfig.json",
