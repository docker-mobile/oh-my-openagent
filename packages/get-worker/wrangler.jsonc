{
  // The Sisyphus Labs account (moved 2026-10-09, sisyphuslabs/common-infra docs/cutover-workers.md).
  // get.omc.nga.hm is a CUSTOM DOMAIN on the Sisyphus Labs omc.nga.hm zone: oh-my-cybersecurity-web fetches
  // get.omc.nga.hm/stats/downloads, and a Worker can reach another Worker on the same zone through a custom
  // domain but not through a route. /stable/* and /beta/* are omc-desktop-releases' zone routes.
  // The hourly rollup runs at :17 (the same minute as on the previous account); it needs the ANALYTICS_TOKEN secret.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "omc-get",
  "main": "src/index.ts",
  "account_id": "6511ce566bfe27228f536a8fb9448be5",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "get.omc.nga.hm", "zone_name": "omc.nga.hm", "custom_domain": true }],
  "rules": [{ "type": "Text", "globs": ["**/*.sh", "**/*.ps1"], "fallthrough": false }],
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "omc-releases" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "omc-get",
      "database_id": "755b541b-49f2-47f2-a266-465dd1860d76",
      "migrations_dir": "migrations"
    }
  ],
  "analytics_engine_datasets": [{ "binding": "DOWNLOADS", "dataset": "omc_downloads" }],
  // ANALYTICS_TOKEN (secret) is a read-only Account Analytics token used only by the hourly rollup.
  // ROLLUP_FIRST_DAY: 2026-10-09 began on the previous account; it is completed by a one-time backfill (both accounts'
  // Analytics Engine, summed), so the hourly rollup must never overwrite it with this account's part of the day.
  "vars": { "ACCOUNT_ID": "6511ce566bfe27228f536a8fb9448be5", "ANALYTICS_DATASET": "omc_downloads", "ROLLUP_FIRST_DAY": "2026-10-10" },
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
